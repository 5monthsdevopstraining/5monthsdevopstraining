# EC2 in a PUBLIC subnet with docker, kubectl, helm and Jenkins. It builds the app image and deploys it.
# The cluster API is private, so kubectl must run inside the VPC - this EC2 is the jump box for it.
# Access is plain SSH: Terraform generates the key pair (saved to eks/terraform/deployer-key.pem).
# Port 22 and Jenkins (8080) are open only to admin_cidrs (default: your current public IP);
# 8080 is also open to GitHub's webhook IPs, so a push can trigger Jenkins.
#   ssh -i eks/terraform/deployer-key.pem ec2-user@<deployer_public_ip>   (see output "ssh_command")

data "aws_ami" "al2023" {
  most_recent = true
  owners      = ["amazon"]

  filter {
    name   = "name"
    values = ["al2023-ami-2023.*-kernel-*-x86_64"]
  }
}

########## SSH key pair (generated by Terraform) ##########

resource "tls_private_key" "deployer" {
  algorithm = "ED25519"
}

resource "aws_key_pair" "deployer" {
  key_name   = "${local.name_prefix}-key-eks-deployer"
  public_key = tls_private_key.deployer.public_key_openssh
}

# Private key on your laptop for "ssh -i" (gitignored). It is also stored in the Terraform state.
resource "local_sensitive_file" "deployer_key" {
  filename        = "${path.module}/deployer-key.pem"
  content         = tls_private_key.deployer.private_key_openssh
  file_permission = "0600"
}

########## Security group ##########

# Your current public IP, used when admin_cidrs is empty
data "http" "my_ip" {
  count = length(var.admin_cidrs) == 0 ? 1 : 0
  url   = "https://checkip.amazonaws.com"
}

# IP ranges GitHub sends webhooks from
data "http" "github_meta" {
  url             = "https://api.github.com/meta"
  request_headers = { Accept = "application/json" }
}

locals {
  admin_cidrs       = length(var.admin_cidrs) > 0 ? var.admin_cidrs : ["${chomp(data.http.my_ip[0].response_body)}/32"]
  github_hook_cidrs = [for c in jsondecode(data.http.github_meta.response_body).hooks : c if !strcontains(c, ":")] # IPv4 only
}

resource "aws_security_group" "deployer" {
  name_prefix = "${local.name_prefix}-sg-eks-deployer-" # unique name, so create_before_destroy works
  description = "EKS deployer EC2 - SSH and Jenkins from allowed IPs, all outbound"
  vpc_id      = aws_vpc.this.id

  tags = { Name = "${local.name_prefix}-sg-eks-deployer" }

  # The EKS API rule (cluster.tf) references this group: create the new one first, so the
  # old one is only deleted after nothing points at it any more
  lifecycle {
    create_before_destroy = true
  }
}

resource "aws_vpc_security_group_ingress_rule" "deployer_ssh" {
  for_each = toset(local.admin_cidrs)

  security_group_id = aws_security_group.deployer.id
  description       = "SSH"
  ip_protocol       = "tcp"
  from_port         = 22
  to_port           = 22
  cidr_ipv4         = each.value
}

resource "aws_vpc_security_group_ingress_rule" "jenkins_admin" {
  for_each = toset(local.admin_cidrs)

  security_group_id = aws_security_group.deployer.id
  description       = "Jenkins UI"
  ip_protocol       = "tcp"
  from_port         = 8080
  to_port           = 8080
  cidr_ipv4         = each.value
}

resource "aws_vpc_security_group_ingress_rule" "jenkins_github" {
  for_each = toset(local.github_hook_cidrs)

  security_group_id = aws_security_group.deployer.id
  description       = "GitHub webhooks to Jenkins"
  ip_protocol       = "tcp"
  from_port         = 8080
  to_port           = 8080
  cidr_ipv4         = each.value
}

resource "aws_vpc_security_group_egress_rule" "deployer_all" {
  security_group_id = aws_security_group.deployer.id
  description       = "EKS API, S3, ECR, RDS secret, GitHub, Docker/Helm/kubectl/Jenkins downloads"
  ip_protocol       = "-1"
  cidr_ipv4         = "0.0.0.0/0"
}

########## Instance ##########

resource "aws_instance" "deployer" {
  ami                         = data.aws_ami.al2023.id
  instance_type               = var.deployer_instance_type
  subnet_id                   = aws_subnet.public[0].id
  associate_public_ip_address = true
  key_name                    = aws_key_pair.deployer.key_name
  vpc_security_group_ids      = [aws_security_group.deployer.id]
  iam_instance_profile        = aws_iam_instance_profile.deployer.name

  user_data                   = file("${path.module}/scripts/deployer.sh")
  user_data_replace_on_change = true

  metadata_options {
    http_tokens = "required" # IMDSv2 only
  }

  root_block_device {
    volume_size = 30 # docker build cache for the .NET SDK image
    volume_type = "gp3"
    encrypted   = true
  }

  tags = { Name = "${local.name_prefix}-ec2-eks-deployer" }

  lifecycle {
    ignore_changes = [ami] # don't replace the instance every time a new AL2023 AMI is released
  }

  depends_on = [aws_route_table_association.public]
}

# Fixed public IP: the Jenkins URL, the GitHub webhook and the SSH address survive stop/start
resource "aws_eip" "deployer" {
  instance = aws_instance.deployer.id
  domain   = "vpc"
  tags     = { Name = "${local.name_prefix}-eip-eks-deployer" }
}
