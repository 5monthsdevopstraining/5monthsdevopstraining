aws_region  = "ap-south-1"
project     = "sample"
environment = "dev"
owner       = "saranya"
created_by  = "saranya"

vpc_cidr = "10.0.0.0/16"
public_subnets = {
  public1 = { cidr = "10.0.1.0/24", az = "ap-south-1a" }
  public2 = { cidr = "10.0.2.0/24", az = "ap-south-1b" }
}

private_subnets = {
  private1 = { cidr = "10.0.3.0/24", az = "ap-south-1a" }
}

instance_type   = "t3.micro"
public_key_path = "~/.ssh/sample-dev-key.pub"
my_ip_cidr      = "" # empty = auto-detect your current IP on every apply