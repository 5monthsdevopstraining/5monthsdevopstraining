
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        AWS_REGION          = 'ap-southeast-2'
        AWS_DEFAULT_REGION  = 'ap-southeast-2'

        EKS_CLUSTER_NAME    = 'dotnet8-eks-dev-eks'
        K8S_NAMESPACE       = 'sample-app'

        ECR_REPOSITORY_URL  = '832474135505.dkr.ecr.ap-southeast-2.amazonaws.com/dotnet8-eks-dev-dotnet-api'

        APP_PROJECT         = 'dotnet/dotnet.csproj'
        DOCKERFILE          = 'docker/Dockerfile'
        SDK_IMAGE           = 'mcr.microsoft.com/dotnet/sdk:10.0'

        S3_BUCKET_NAME      = 'dotnet8-eks-dev-docs-832474135505'

        DB_HOST             = 'dotnet8-eks-dev-postgres.c74gk4480h4a.ap-southeast-2.rds.amazonaws.com'
        DB_PORT             = '5432'
        DB_NAME             = 'documentsdb'

        DB_SECRET_ID        = 'arn:aws:secretsmanager:ap-southeast-2:832474135505:secret:rds!db-f3da0dfa-55bb-42ee-bf3b-b82497e41753-QYkRK7'

        K8S_DEPLOYMENT      = 'dotnet-api'
        K8S_CONTAINER       = 'dotnet-api'
        K8S_SERVICE         = 'dotnet-api'
        K8S_SECRET          = 'dotnet-api-connection'
        K8S_CONFIGMAP       = 'dotnet-api-config'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm

                script {
                    env.GIT_SHA = sh(
                        script: 'git rev-parse --short=8 HEAD',
                        returnStdout: true
                    ).trim()

                    env.IMAGE_TAG = "${env.BUILD_NUMBER}-${env.GIT_SHA}"
                    env.IMAGE_URI = "${env.ECR_REPOSITORY_URL}:${env.IMAGE_TAG}"
                }

                echo "Git commit: ${env.GIT_SHA}"
                echo "Docker image: ${env.IMAGE_URI}"

                sh '''
                    set -eu

                    echo "Checking application files..."

                    test -f "$APP_PROJECT"
                    test -f "$DOCKERFILE"

                    echo "Project and Dockerfile found."
                '''
            }
        }

        stage('Docker Access Check') {
            steps {
                sh '''
                    set -eu

                    echo "===== PIPELINE IDENTITY ====="
                    id
                    groups

                    echo "===== PIPELINE HOST ====="
                    hostname
                    hostname -I 2>/dev/null || true

                    echo "===== DOCKER SOCKET ====="
                    ls -l /var/run/docker.sock
                    stat -c 'Owner=%U Group=%G Permissions=%a' /var/run/docker.sock

                    echo "===== DOCKER CONNECTION ====="
                    docker version
                    docker info --format 'Docker server version: {{.ServerVersion}}'

                    echo "Docker access successful."
                '''
            }
        }

        stage('AWS Access Check') {
            steps {
                sh '''
                    set -eu

                    echo "Checking AWS IAM role..."

                    aws sts get-caller-identity

                    echo "Checking ECR repository..."

                    aws ecr describe-repositories \
                        --repository-names dotnet8-eks-dev-dotnet-api \
                        --region "$AWS_REGION" \
                        --query 'repositories[0].repositoryUri' \
                        --output text

                    echo "AWS access successful."
                '''
            }
        }

        stage('Restore') {
            steps {
                sh '''
                    set -eu

                    mkdir -p "$WORKSPACE/.nuget"

                    docker pull "$SDK_IMAGE"

                    docker run --rm \
                        --user "$(id -u):$(id -g)" \
                        -e HOME=/tmp \
                        -e NUGET_PACKAGES=/tmp/.nuget/packages \
                        -v "$WORKSPACE:/src" \
                        -v "$WORKSPACE/.nuget:/tmp/.nuget" \
                        -w /src \
                        "$SDK_IMAGE" \
                        dotnet restore "$APP_PROJECT"
                '''
            }
        }

        stage('Build') {
            steps {
                sh '''
                    set -eu

                    docker run --rm \
                        --user "$(id -u):$(id -g)" \
                        -e HOME=/tmp \
                        -e NUGET_PACKAGES=/tmp/.nuget/packages \
                        -v "$WORKSPACE:/src" \
                        -v "$WORKSPACE/.nuget:/tmp/.nuget" \
                        -w /src \
                        "$SDK_IMAGE" \
                        dotnet build "$APP_PROJECT" \
                        --configuration Release \
                        --no-restore
                '''
            }
        }

        stage('Test') {
            steps {
                script {
                    def testProject = sh(
                        script: "find . -type f \\( -name '*Tests.csproj' -o -name '*.Test.csproj' \\) -print -quit",
                        returnStdout: true
                    ).trim()

                    if (testProject) {
                        sh """
                            set -eu

                            docker run --rm \\
                                --user "\$(id -u):\$(id -g)" \\
                                -e HOME=/tmp \\
                                -e NUGET_PACKAGES=/tmp/.nuget/packages \\
                                -v "\$WORKSPACE:/src" \\
                                -v "\$WORKSPACE/.nuget:/tmp/.nuget" \\
                                -w /src \\
                                "$SDK_IMAGE" \\
                                dotnet test "$testProject" \\
                                --configuration Release \\
                                --no-restore
                        """
                    } else {
                        echo 'No test project found. Skipping tests.'
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    set -eu

                    echo "Building Docker image..."

                    docker build \
                        --file "$DOCKERFILE" \
                        --tag "$IMAGE_URI" \
                        .

                    docker images "$IMAGE_URI"
                '''
            }
        }

        stage('Push to ECR') {
            steps {
                sh '''
                    set -eu

                    echo "Logging in to Amazon ECR..."

                    aws ecr get-login-password \
                        --region "$AWS_REGION" \
                    | docker login \
                        --username AWS \
                        --password-stdin "$ECR_REPOSITORY_URL"

                    echo "Pushing image..."

                    docker push "$IMAGE_URI"

                    echo "Image pushed successfully."
                '''
            }
        }

        stage('Cluster Setup') {
            steps {
                sh '''
                    set -eu

                    export KUBECONFIG="$WORKSPACE/.kube/config"

                    mkdir -p "$WORKSPACE/.kube"
                    chmod 700 "$WORKSPACE/.kube"

                    echo "Connecting to EKS..."

                    aws eks update-kubeconfig \
                        --region "$AWS_REGION" \
                        --name "$EKS_CLUSTER_NAME" \
                        --kubeconfig "$KUBECONFIG"

                    echo "Checking EKS nodes..."

                    kubectl get nodes

                    kubectl get namespace "$K8S_NAMESPACE"
                '''
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    set -eu

                    export KUBECONFIG="$WORKSPACE/.kube/config"

                    echo "Retrieving database credentials..."

                    SECRET_JSON=$(aws secretsmanager get-secret-value \
                        --secret-id "$DB_SECRET_ID" \
                        --region "$AWS_REGION" \
                        --query SecretString \
                        --output text)

                    DB_USERNAME=$(printf '%s' "$SECRET_JSON" | jq -er '.username // .Username')
                    DB_PASSWORD=$(printf '%s' "$SECRET_JSON" | jq -er '.password // .Password')

                    CONNECTION_STRING="Host=${DB_HOST};Port=${DB_PORT};Database=${DB_NAME};Username=${DB_USERNAME};Password=${DB_PASSWORD};SSL Mode=Require;Trust Server Certificate=true"

                    unset SECRET_JSON DB_USERNAME DB_PASSWORD

                    echo "Creating Kubernetes database secret..."

                    SECRET_FILE="$WORKSPACE/.rds-connection-string"

                    umask 077
                    printf '%s' "$CONNECTION_STRING" > "$SECRET_FILE"
                    unset CONNECTION_STRING

                    kubectl create secret generic "$K8S_SECRET" \
                        --namespace "$K8S_NAMESPACE" \
                        --from-file=ConnectionStrings__Rds="$SECRET_FILE" \
                        --dry-run=client \
                        -o yaml \
                    | kubectl apply -f -

                    rm -f "$SECRET_FILE"

                    echo "Creating application ConfigMap..."

                    kubectl create configmap "$K8S_CONFIGMAP" \
                        --namespace "$K8S_NAMESPACE" \
                        --from-literal=ASPNETCORE_ENVIRONMENT=Production \
                        --from-literal=ASPNETCORE_URLS=http://+:8080 \
                        --from-literal=AWS_REGION="$AWS_REGION" \
                        --from-literal=S3_BUCKET_NAME="$S3_BUCKET_NAME" \
                        --dry-run=client \
                        -o yaml \
                    | kubectl apply -f -

                    echo "Applying Kubernetes Deployment and Service..."

                    cat <<EOF | kubectl apply -f -
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ${K8S_DEPLOYMENT}
  namespace: ${K8S_NAMESPACE}
spec:
  replicas: 2
  selector:
    matchLabels:
      app: dotnet-api
  template:
    metadata:
      labels:
        app: dotnet-api
    spec:
      containers:
        - name: ${K8S_CONTAINER}
          image: ${IMAGE_URI}
          imagePullPolicy: Always
          ports:
            - name: http
              containerPort: 8080
              protocol: TCP
          envFrom:
            - configMapRef:
                name: ${K8S_CONFIGMAP}
          env:
            - name: ConnectionStrings__Rds
              valueFrom:
                secretKeyRef:
                  name: ${K8S_SECRET}
                  key: ConnectionStrings__Rds
          readinessProbe:
            tcpSocket:
              port: 8080
            initialDelaySeconds: 10
            periodSeconds: 10
          livenessProbe:
            tcpSocket:
              port: 8080
            initialDelaySeconds: 30
            periodSeconds: 20
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              cpu: 500m
              memory: 512Mi
---
apiVersion: v1
kind: Service
metadata:
  name: ${K8S_SERVICE}
  namespace: ${K8S_NAMESPACE}
spec:
  type: ClusterIP
  selector:
    app: dotnet-api
  ports:
    - name: http
      port: 80
      targetPort: http
      protocol: TCP
EOF

                    echo "Deployment resources applied."
                '''
            }
        }

        stage('Wait for Rollout') {
            steps {
                sh '''
                    set -eu

                    export KUBECONFIG="$WORKSPACE/.kube/config"

                    echo "Waiting for application deployment..."

                    kubectl rollout status \
                        deployment/"$K8S_DEPLOYMENT" \
                        --namespace "$K8S_NAMESPACE" \
                        --timeout=180s

                    echo "Deployment rollout successful."
                '''
            }
        }

        stage('Verify') {
            steps {
                sh '''
                    set -eu

                    export KUBECONFIG="$WORKSPACE/.kube/config"

                    echo "===== DEPLOYMENT ====="
                    kubectl get deployment \
                        --namespace "$K8S_NAMESPACE"

                    echo "===== PODS ====="
                    kubectl get pods \
                        --namespace "$K8S_NAMESPACE" \
                        -o wide

                    echo "===== SERVICE ====="
                    kubectl get service \
                        --namespace "$K8S_NAMESPACE"

                    echo "===== ENDPOINTS ====="
                    kubectl get endpoints \
                        --namespace "$K8S_NAMESPACE" \
                        "$K8S_SERVICE"

                    echo "===== PORT FORWARD ====="

                    sudo -n systemctl restart dotnet-api-port-forward

                    sudo -n systemctl status \
                        dotnet-api-port-forward \
                        --no-pager

                    echo "===== APPLICATION HTTP CHECK ====="

                    for attempt in $(seq 1 30); do
                        if curl -fsS \
                            http://127.0.0.1:5000/swagger/v1/swagger.json \
                            -o /dev/null; then

                            echo "Application HTTP check successful."
                            exit 0
                        fi

                        echo "Application not ready yet. Attempt: $attempt/30"
                        sleep 5
                    done

                    echo "Application HTTP check failed."
                    exit 1
                '''
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: .NET application deployed to Amazon EKS.'
            echo "Docker image: ${env.IMAGE_URI}"
        }

        failure {
            echo 'FAILED: Check the first failed pipeline stage and its console output.'
        }

        always {
            sh '''
                echo "Starting pipeline cleanup..."

                rm -f "$WORKSPACE/.rds-connection-string"

                if [ -n "${WORKSPACE:-}" ]; then
                    rm -rf "$WORKSPACE/.kube"
                fi

                if command -v docker >/dev/null 2>&1; then
                    if [ -n "${IMAGE_URI:-}" ]; then
                        docker image rm "$IMAGE_URI" 2>/dev/null || true
                    fi

                    docker logout "$ECR_REPOSITORY_URL" 2>/dev/null || true
                fi

                echo "Cleanup completed."
            '''
        }
    }
}
